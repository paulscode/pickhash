# Pickhash local/dev environment. Copy to `.env` and fill in your own values.
# NEVER commit a real .env — it is gitignored. These credentials can spend Bitcoin.

# MiningRigRentals API v2 credentials (Account -> API). Needs Rental: Write + Balance: Read.
MRR_KEY=your-mrr-api-key
MRR_SECRET=your-mrr-api-secret

# Optional: point at a HashGG instance to auto-discover your public stratum endpoint.
# HASHGG_HOST=host.docker.internal
# HASHGG_PORT=3000
